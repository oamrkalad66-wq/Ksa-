-- 1. جعل الأخذ يدوي وفوري فوراً بمجرد الضغط (بدون انتظار أو تعليق)
local function setInstantInteraction(obj)
    if obj:IsA("ProximityPrompt") then
        obj.HoldDuration = 0 -- صفر ثواني تعليق
        obj.RequiresLineOfSight = false
    end
end

for _, obj in pairs(workspace:GetDescendants()) do
    setInstantInteraction(obj)
end
workspace.DescendantAdded:Connect(setInstantInteraction)

-- 2. تفعيل الفويد / النوكليب (Noclip) باستمرار
RunService.Stepped:Connect(function()
    local char = player.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

